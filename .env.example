# Bonefree - exemplo de ambiente para Docker Compose em producao.
# Copie para .env, substitua todos os valores e nunca versione o arquivo .env.

# Dominio publico da API. Crie antes um registro DNS A apontando para a VPS.
API_DOMAIN=api.example.com

# PostgreSQL. Use apenas letras, numeros, _ e - na senha porque ela faz parte da URL.
# Uma opcao segura: openssl rand -hex 32
POSTGRES_DB=bonefree
POSTGRES_USER=bonefree
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Aplicacao
APP_NAME=Bonefree API
APP_VERSION=0.1.0
ENVIRONMENT=production
APP_DEBUG=false
PORT=8000
AUTO_APPLY_MIGRATIONS=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Informe somente as origens reais do frontend, separadas por virgula e sem barra final.
CORS_ORIGINS=https://example.com,https://www.example.com

# Redis e rate limiting. REDIS_URL e definido internamente pelo Compose.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP_REQUESTS=30
RATE_LIMIT_AUTH_IP_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_IDENTIFIER_REQUESTS=10
RATE_LIMIT_LOGIN_IDENTIFIER_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_EMAIL_REQUESTS=10
RATE_LIMIT_REGISTER_EMAIL_WINDOW_SECONDS=300
RATE_LIMIT_ADMIN_REQUESTS=100
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_LOGIN_REQUESTS=5
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_ORDER_REQUESTS=10
RATE_LIMIT_ORDER_WINDOW_SECONDS=60
ORDER_ACCESS_TOKEN_EXPIRATION_HOURS=24
RATE_LIMIT_REDIS_FAILURE_MODE=allow

# Sessoes
SESSION_EXPIRATION_MINUTES=10080
ADMIN_SESSION_EXPIRATION_MINUTES=480
ADMIN_SESSION_INACTIVITY_EXPIRATION_MINUTES=60

# Email. "terminal" apenas registra emails nos logs; use "smtp" para envios reais.
EMAIL_PROVIDER=terminal
AUTH_EMAILS_ENABLED=true
EMAIL_RECEIPTS_ENABLED=true
AUTH_EMAIL_FROM=no-reply@example.com
AUTH_EMAIL_FROM_NAME=Bonefree
EMAIL_FROM=no-reply@example.com
EMAIL_SEND_TIMEOUT_SECONDS=10
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=

# URL publica da API; o Compose substitui este valor usando API_DOMAIN.
PUBLIC_BASE_URL=https://api.example.com
