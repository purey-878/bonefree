# Copy this file to .env and fill in real values. Do not commit .env.

# Database
# Defaults to backend/bonefree_rest_2.db when omitted.
# DATABASE_URL=sqlite:///backend/bonefree_rest_2.db

# Redis / rate limiting
# Development and tests use in-memory storage; production requires REDIS_URL.
# REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP_REQUESTS=30
RATE_LIMIT_AUTH_IP_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_IDENTIFIER_REQUESTS=10
RATE_LIMIT_LOGIN_IDENTIFIER_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_EMAIL_REQUESTS=10
RATE_LIMIT_REGISTER_EMAIL_WINDOW_SECONDS=300
RATE_LIMIT_ADMIN_REQUESTS=100
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_LOGIN_REQUESTS=5
RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_ORDER_REQUESTS=10
RATE_LIMIT_ORDER_WINDOW_SECONDS=60
ORDER_ACCESS_TOKEN_EXPIRATION_HOURS=24
RATE_LIMIT_REDIS_FAILURE_MODE=allow

# Receipt sending
EMAIL_RECEIPTS_ENABLED=true

# Option A: Gmail or another SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=purey878@gmail.com
SMTP_PASSWORD=nxpyftmcykmddozq
SMTP_STARTTLS=true
SMTP_SECURE=false

# Option B: SendGrid
# SENDGRID_API_KEY=SG_your_key_here

# Receipt branding/contact
RECEIPT_FROM_EMAIL=purey878@gmail.com
RECEIPT_COMPANY_NAME=BONEFREE
