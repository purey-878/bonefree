# Core Platform backend environment example
# Copy this file to backend/.env or project-root .env and adjust values as needed.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Core Platform API
APP_VERSION=0.1.0
ENVIRONMENT=development
APP_DEBUG=false
PORT=8000
API_PREFIX=/api

# Documentation is enabled automatically when ENVIRONMENT=development.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default, if omitted, is SQLite at backend/core_platform.db.
DATABASE_URL=sqlite:///backend/core_platform.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Empty and recognized databases are upgraded automatically. Databases from the
# archived pre-baseline history must be recreated through the catalog seed.
AUTO_APPLY_MIGRATIONS=true

# -----------------------------------------------------------------------------
# Redis / rate limiting
# -----------------------------------------------------------------------------
# Development and tests use the in-memory implementation. Production requires
# a real Redis URL, for example redis://redis:6379/0.
REDIS_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP_REQUESTS=30
RATE_LIMIT_AUTH_IP_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_IDENTIFIER_REQUESTS=10
RATE_LIMIT_LOGIN_IDENTIFIER_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_EMAIL_REQUESTS=10
RATE_LIMIT_REGISTER_EMAIL_WINDOW_SECONDS=300
RATE_LIMIT_STAFF_REQUESTS=100
RATE_LIMIT_STAFF_WINDOW_SECONDS=60
RATE_LIMIT_STAFF_LOGIN_REQUESTS=5
RATE_LIMIT_STAFF_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_ORDER_REQUESTS=10
RATE_LIMIT_ORDER_WINDOW_SECONDS=60
ORDER_ACCESS_TOKEN_EXPIRATION_HOURS=24
# allow lets a request continue if Redis fails; block returns HTTP 429.
RATE_LIMIT_REDIS_FAILURE_MODE=allow

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
SESSION_EXPIRATION_MINUTES=10080
STAFF_SESSION_EXPIRATION_MINUTES=480
STAFF_SESSION_INACTIVITY_EXPIRATION_MINUTES=60

# -----------------------------------------------------------------------------
# CORS / Public URLs
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:5173,http://bonefree.localhost:5173,http://bonefree.localhost:5174,http://127.0.0.1,http://127.0.0.1:5174,https://bonefree.pt,https://www.bonefree.pt

# Used to build public asset URLs, links, receipt logos, etc.
PUBLIC_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Email provider
# -----------------------------------------------------------------------------
# Available providers:
# - terminal: prints emails to stdout. Good for local tests/dev and requires no SMTP.
# - smtp: sends emails through SMTP.
EMAIL_PROVIDER=terminal
AUTH_EMAILS_ENABLED=true
EMAIL_SEND_TIMEOUT_SECONDS=10

# Sender used by auth emails.
# If omitted, the app falls back to EMAIL_FROM or SMTP_USER.
AUTH_EMAIL_FROM=
AUTH_EMAIL_FROM_NAME=Bonefree
EMAIL_FROM=

# -----------------------------------------------------------------------------
# SMTP email provider
# -----------------------------------------------------------------------------
# Required only when EMAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
# Alternative password variable supported for compatibility:
SMTP_PASS=

# Example Gmail SMTP config:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_STARTTLS=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-google-app-password
# AUTH_EMAIL_FROM=your-email@gmail.com
