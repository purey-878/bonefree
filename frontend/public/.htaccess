# Hostinger Apache/LiteSpeed document root. Upload dotfiles from dist as well.
Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html
ErrorDocument 410 /410.html
RewriteEngine On
RewriteOptions AllowNoSlash

# Canonical origin. If a reverse proxy terminates TLS, use Hostinger's verified
# HTTPS configuration instead of trusting arbitrary forwarded request headers.
RewriteCond %{HTTP_HOST} !^bonefree\.pt$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://bonefree.pt%{REQUEST_URI} [R=301,L]

# Permanently retired features have no equivalent restaurant page.
RewriteRule ^(?:cart|basket|checkout|orders?|guest-orders|order-tracking|order-confirmation|profile|account|login|register|forgot-password|reset-password|loyalty|rewards|coupons|payment|payments|invoices|receipts)(?:/|\.html|$) - [G,L,NC]
RewriteRule ^admin/(?:staff|kitchen)(?:/|$) - [G,L,NC]
RewriteRule ^(?:auth|customer)(?:/|$) - [G,L,NC]

# Internal SPA shells are not standalone public pages.
RewriteCond %{THE_REQUEST} \s/+(?:dish|admin|reservation-confirmation)\.html[\s?] [NC]
RewriteRule ^(?:dish|admin|reservation-confirmation)\.html$ - [R=404,L]

# Use one canonical URL for each public route, including old .html variants.
RewriteRule ^(menu|about|events|contact|privacy|reservations|meal-finder)(?:/index\.html|\.html|/)$ /$1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Agent representations are explicit public routes, never a catch-all.
# PHP is required for MIME negotiation and the read-only MCP transport.
RewriteCond %{THE_REQUEST} \s/+agent\.php[\s?] [NC]
RewriteRule ^agent\.php$ - [R=404,L]
RewriteRule ^mcp/$ /mcp [R=301,L]
RewriteRule ^mcp$ agent.php?representation=mcp [END]
RewriteRule ^index\.md$ agent.php?representation=markdown&page=/&force=1 [END]
RewriteRule ^(menu|about|events|contact|privacy|reservations|meal-finder)\.md$ agent.php?representation=markdown&page=/$1&force=1 [END]
# The bridge parses Accept quality weights (including q=0) and preserves HTML
# when it is preferred. HEAD uses the same headers without returning a body.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^$ agent.php?representation=markdown&page=/ [END]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteRule ^(menu|about|events|contact|privacy|reservations|meal-finder)$ agent.php?representation=markdown&page=/$1 [END]

# Route-specific HTML before the directory/file checks avoids a trailing slash
# redirect and supplies the right metadata to crawlers and social previews.
RewriteRule ^(menu|about|events|contact|privacy|reservations|meal-finder)$ $1/index.html [END]
RewriteRule ^reservations/confirmation/?$ reservation-confirmation.html [END]
RewriteRule ^product/([1-9][0-9]*)/$ /product/$1 [R=301,L]
RewriteRule ^product/[1-9][0-9]*$ dish.html [END]
RewriteRule ^admin/(?:login|dashboard|super)/?$ admin.html [END]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [END]
RewriteRule ^$ index.html [END]
# Unknown URLs must not become successful homepage responses.
RewriteRule ^ - [R=404,L]

# Private links keep their token in a fragment. Never cache the confirmation shell.
<IfModule mod_headers.c>
  <Files "reservation-confirmation.html">
    Header always set Cache-Control "no-store, private, max-age=0"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Robots-Tag "noindex, nofollow"
  </Files>
</IfModule>

# Static discovery files must retain their actual media types.
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType text/markdown .md
  AddType application/json .json
</IfModule>
<IfModule mod_headers.c>
  Header always set Content-Signal "search=yes, ai-train=no"
  Header always merge Link "<https://bonefree.pt/llms.txt>; rel=\"describedby\"; type=\"text/plain\""
  <FilesMatch "\.html$">
    Header always merge Vary "Accept"
  </FilesMatch>
</IfModule>
